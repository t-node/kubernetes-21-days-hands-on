# Shell scripts must keep LF endings, or they fail inside Linux containers
# and on WSL with "bad interpreter: /usr/bin/env: no such file or directory".
*.sh            text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf

# Python served into containers from a ConfigMap -- keep LF
*.py            text eol=lf
*.ps1           text eol=crlf
